
def erlang_b(E, C):
    """Blocking probability for offered load E and C channels."""
    b = 1.0

    for m in range(1, C + 1):
        b = E * b / (m + E * b)

    return b


def channels_needed(E, gos):
    """Find the minimum number of channels for target GOS."""
    C = 1

    while erlang_b(E, C) > gos:
        C += 1

    return C


def max_load(C, gos, hi=500.0):
    """Calculate maximum offered load using bisection."""
    lo = 0.0

    for _ in range(60):
        mid = (lo + hi) / 2

        if erlang_b(mid, C) < gos:
            lo = mid
        else:
            hi = mid

    return lo


# Display blocking probability
print("Blocking probability B(E, C)")

loads = (2, 5, 10, 20)

print(f"{'C':>4}" +
