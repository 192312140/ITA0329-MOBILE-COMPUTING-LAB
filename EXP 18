for C in (5, 10, 20, 30):
    print(f"{C:4d}" +
          "".join(f"{erlang_b(e, C):10.4f}" for e in loads))


# Offered traffic calculation
users = 2000
calls_per_hour = 1.5
hold_s = 120

E = users * calls_per_hour * hold_s / 3600

print(f"\nOffered load: {users} users x "
      f"{calls_per_hour} calls/h x {hold_s} s "
      f"= {E:.1f} erlang")


# Calculate channels required for different GOS values
for gos in (0.05, 0.02, 0.01):
    print(f"GOS {gos:.0%}: channels needed = "
          f"{channels_needed(E, gos)}")


# Maximum traffic load for 20 channels
print(f"Max load for 20 channels at 2% blocking: "
      f"{max_load(20, 0.02):.2f} erlang")
